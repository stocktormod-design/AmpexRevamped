{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "cd desktop && npm run build",
  "installCommand": "cd desktop && npm install",
  "outputDirectory": "desktop/dist",
  "framework": null,

  "github": { "silent": true },

  "rewrites": [{ "source": "/(.*)", "destination": "/" }],

  "headers": [
    {
      "_": "Tjenestearbeideren MÅ hentes på nytt. Cachenavnet i sw.js stemples med byggetidspunktet (desktop/scripts/stemple-sw.mjs), og en fane som får en gammel sw.js fra kanten vet ikke at det finnes noe nyere.",
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}

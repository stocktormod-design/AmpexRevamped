{
  "rules": [
    {
      "allowed": {
        "origins": [
          "capacitor://localhost",
          "http://localhost:5174",
          "http://localhost:5175",
          "http://tauri.localhost",
          "https://ampex.no",
          "https://www.ampex.no",
          "tauri://localhost"
        ],
        "methods": [
          "GET",
          "PUT",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}

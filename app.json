{
  "expo": {
    "name": "Ampex",
    "slug": "ampex",
    "version": "1.0.0",
    "scheme": "ampex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.ampex.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ampex bruker kameraet og LiDAR til å skanne rom i 3D.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.ampex.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-no-push-entitlement.js",
      "./plugins/with-widget-version.js",
      "expo-router",
      "expo-status-bar",
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Ampex bruker mikrofonen til stemmestyrt utfylling av skjema og talekommandoer.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Ampex bruker bevegelsessensoren til å merke når du løfter telefonen mot øret under en samtale med AI-assistenten."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "VoiceAssistantActivity",
              "displayName": "Ampex AI-assistent",
              "description": "Viser status for stemmestyrt skjemautfylling og talekommandoer.",
              "supportedFamilies": [
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
